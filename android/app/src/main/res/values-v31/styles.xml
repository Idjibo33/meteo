<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : le splash système remplace le windowBackground pendant
         le démarrage. On lui donne le même spinner teal et le même fond noir. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_spinner</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/launch_image</item>
    </style>
</resources>
